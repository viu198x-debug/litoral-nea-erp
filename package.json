{
  "name": "litoral-nea-erp",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run start:dev",
    "build": "npm --workspace frontend run build:site && node scripts/prepare-site-output.mjs",
    "build:all": "npm --workspace backend run build && npm --workspace frontend run build",
    "lint": "npm --workspace frontend run lint && npm --workspace backend run lint",
    "test": "npm --workspace backend run test && npm --workspace frontend run test",
    "prisma:generate": "CHECKPOINT_DISABLE=1 PRISMA_HIDE_UPDATE_MESSAGE=1 prisma generate --schema database/prisma/schema.prisma",
    "prisma:migrate": "CHECKPOINT_DISABLE=1 PRISMA_HIDE_UPDATE_MESSAGE=1 prisma migrate dev --schema database/prisma/schema.prisma",
    "prisma:seed": "tsx database/prisma/seed.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "brace-expansion@<2.0.0": "1.1.18",
    "browserslist": "4.28.9",
    "deepmerge-ts": "8.0.2",
    "esbuild": "0.28.2",
    "fast-uri": "3.1.7",
    "js-yaml": "4.3.2",
    "multer": "2.3.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.28"
  }
}
