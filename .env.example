# PostgreSQL
POSTGRES_DB=litoral_nea_erp
POSTGRES_USER=litoral_nea
POSTGRES_PASSWORD=cambiar_en_produccion
DATABASE_URL=postgresql://litoral_nea:cambiar_en_produccion@postgres:5432/litoral_nea_erp?schema=public

# API / seguridad
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000,http://localhost:8080
BACKEND_PUBLIC_URL=http://localhost:4000
DOCKER_PUBLIC_URL=http://localhost:8080
TRUST_PROXY=false
JWT_ACCESS_SECRET=reemplazar_por_64_caracteres_aleatorios
JWT_REFRESH_SECRET=reemplazar_por_otro_secreto_64_caracteres
CSRF_SECRET=reemplazar_por_un_tercer_secreto_64_caracteres
JWT_ISSUER=litoral-nea-erp
JWT_AUDIENCE=litoral-nea-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15
MAX_ACTIVE_SESSIONS=5
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
JSON_BODY_LIMIT=1mb
ALLOW_SELF_APPROVAL=false

# OAuth/OIDC (dejar vacío hasta crear las aplicaciones en Google y Microsoft)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Archivos
DOCUMENT_STORAGE_PATH=/app/storage/documents
MAX_UPLOAD_MB=50

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_DEMO_MODE=false

# Datos de demostración (desactivar en producción)
SEED_DEMO=true

# Backups
BACKUP_RETENTION_DAYS=30
BACKUP_CRON=0 2 * * *
